# MarketPulse AI - Backend Configuration
# =====================================

# Application Environment (development, testing, production)
APP_ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# SQLite Database
DATABASE_PATH=marketpulse.db

# Upstox API Credentials (Get from https://developer.upstox.com/)
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Upstox Daily Access Token (optional if using OAuth flow; tokens expire daily at 03:30 AM IST)
UPSTOX_ACCESS_TOKEN=

# Supported Instruments (STRICT: ONLY HDFCBANK, ICICIBANK. RELIANCE is strictly forbidden)
SUPPORTED_INSTRUMENTS=HDFCBANK,ICICIBANK

# Market Hours (IST)
MARKET_TIMEZONE=Asia/Kolkata

